# Result Darpan - Environment Variables Configuration
# Copy this file to .env and configure your secret credentials.
# NEVER commit your actual .env file with secrets into version control.

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Administrator Credentials & Access
ADMIN_EMAIL=rajwarish38@gmail.com
# ADMIN_PASSWORD=your_secure_admin_password_here
# Optional comma-separated list of secondary authorized admin emails:
# ADMIN_EMAILS=admin2@resultdarpan.com,admin3@resultdarpan.com

# SMTP Mail Relay Configuration (Optional - for direct email sending)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user@gmail.com
# SMTP_PASS=your_smtp_app_password
# SMTP_FROM="Result Darpan" <noreply@resultdarpan.com>

# Contact Form Inquiries Target
CONTACT_EMAIL=rajwarish38@gmail.com

# Live Site Synchronization URL (Used by local cloud sync daemon)
LIVE_SITE_URL=https://resultdarpan.com

